generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id
  userID       String    @unique
  passwordHash String?
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())
  session      Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Grade {
  student_id  String @id
  average_gpa Float

  @@map("grades")
}

model Condition {
  student_id       String @id
  name             String
  graduation_year  Int
  gender           String
  political_status String
  major            String
  address          String

  @@map("condition")
}

model Hard {
  student_id String @id
  hard_type  String

  @@map("hard")
}

model SecondCourse {
  student_id    String @id
  courses_count Int

  @@map("second_course")
}

model Award {
  student_id         String @id
  scholarships_count Int

  @@map("award")
}

model Job {
  student_id             String  @id
  graduation_destination String
  organization_name      String?
  organization_type      String?
  industry               String?
  location               String?
  position_category      String?

  @@map("job")
}
